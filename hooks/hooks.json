{
  "description": "antibody: learn from Claude's own tool failures and stop them recurring",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\" PreToolUse", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|TaskStop|KillShell|KillBash",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\" PostToolUse", "timeout": 20 }]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/hook.mjs\" PostToolUseFailure", "timeout": 10 }]
      }
    ]
  }
}
